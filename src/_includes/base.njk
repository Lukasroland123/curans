<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titel | safe }}</title>
<meta name="description" content="{{ beskrivelse | safe }}">
{#- Samme begrundelse som paa soestersitet: fejlsiden skal hverken indekseres
    eller have en canonical, fordi /404.html omdirigeres til /404. -#}
{% if noindex %}
<meta name="robots" content="noindex">
{% else %}
<link rel="canonical" href="{{ site.domaene }}{{ page.url }}">
{% endif %}
<link rel="stylesheet" href="/assets/css/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌿</text></svg>">
<meta property="og:type" content="website">
<meta property="og:locale" content="da_DK">
<meta property="og:site_name" content="{{ site.navn }}">
<meta property="og:title" content="{{ titel | safe }}">
<meta property="og:description" content="{{ beskrivelse | safe }}">
{% if not noindex %}<meta property="og:url" content="{{ site.domaene }}{{ page.url }}">
{% endif %}<meta property="og:image" content="{{ site.domaene }}{{ og_billede | default("/billeder/forside-praksis.jpg", true) }}">
<meta name="twitter:card" content="summary_large_image">

{% include "schema.njk" %}
</head>
<body>

<a class="skip-link" href="#indhold">Gå til indhold</a>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="/">
      <span class="logo__mark" aria-hidden="true">
        {#- To samtalebobler, der overlapper. Narrativ terapi handler om de
            fortaellinger, der bliver til mellem to mennesker - ikke om en
            enkelt stemme. Derfor to, ikke en. -#}
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9.5 3C5.9 3 3 5.5 3 8.6c0 1.7.9 3.3 2.3 4.3-.1.9-.5 1.9-1.2 2.8 1.3-.2 2.5-.7 3.4-1.4.6.2 1.3.3 2 .3h.2a5.6 5.6 0 0 1-.2-1.5c0-3.4 3.2-6.1 7.1-6.1h.4C16.3 4.7 13.2 3 9.5 3zm7.1 5.9c-3.1 0-5.6 2.1-5.6 4.6 0 2.6 2.5 4.6 5.6 4.6.5 0 1.1 0 1.6-.2.8.6 1.8 1 2.9 1.2-.6-.8-1-1.6-1.1-2.4 1.2-.8 1.9-2 1.9-3.2 0-2.5-2.5-4.6-5.3-4.6z"/></svg>
      </span>
      <span>{{ site.navn }}
        <small>{{ site.undertitel }}</small>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hovedmenu">
      <svg class="nav-toggle__open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="nav-toggle__close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      Menu
    </button>

    <nav class="nav" id="hovedmenu" aria-label="Hovedmenu">
      <a href="/"{% if side == 'forside' %} aria-current="page"{% endif %}>Forside</a>

      {#- Samme greb som paa soestersitet: den foerste beslutning en besoegende
          traeffer er "er det mig selv, familien eller mit arbejde?". Lad
          menuen stille det spoergsmaal i stedet for at gemme det i en liste. #}
      <div class="nav__group">
        <button class="nav__parent" type="button" aria-expanded="false" aria-controls="undermenu-terapi"{% if side in ['terapi','traumebehandling','familiebehandling'] %} aria-current="true"{% endif %}>Terapi</button>
        <ul class="nav__sub" id="undermenu-terapi">
          <li><a href="/terapi/"{% if side == 'terapi' %} aria-current="page"{% endif %}>Individuel terapi<small>Samtaler for børn, unge og voksne</small></a></li>
          <li><a href="/traumebehandling/"{% if side == 'traumebehandling' %} aria-current="page"{% endif %}>Traumebehandling<small>PTSD og kompleks PTSD</small></a></li>
          <li><a href="/familiebehandling/"{% if side == 'familiebehandling' %} aria-current="page"{% endif %}>Familiebehandling<small>Når relationerne er kørt fast</small></a></li>
        </ul>
      </div>

      <div class="nav__group">
        <button class="nav__parent" type="button" aria-expanded="false" aria-controls="undermenu-fagligt"{% if side in ['bisidderstoette','supervision'] %} aria-current="true"{% endif %}>Støtte &amp; supervision</button>
        <ul class="nav__sub" id="undermenu-fagligt">
          <li><a href="/bisidderstoette/"{% if side == 'bisidderstoette' %} aria-current="page"{% endif %}>Bisidderstøtte<small>Møder på kommunen og dine rettigheder</small></a></li>
          <li><a href="/supervision/"{% if side == 'supervision' %} aria-current="page"{% endif %}>Supervision<small>Faglig sparring for personalegrupper</small></a></li>
        </ul>
      </div>

      <a href="/priser/"{% if side == 'priser' %} aria-current="page"{% endif %}>Priser</a>
      <a href="/om-lotte/"{% if side == 'omlotte' %} aria-current="page"{% endif %}>Om Lotte</a>
      <a href="/kontakt/"{% if side == 'kontakt' %} aria-current="page"{% endif %}>Kontakt</a>
      {% if side == 'kontakt' %}
      <a class="btn btn--primary" href="tel:{{ site.telefon_link }}">Ring {{ site.telefon }}</a>
      {% else %}
      <a class="btn btn--primary" href="/kontakt/">{{ site.cta_knap }}</a>
      {% endif %}
    </nav>
  </div>
</header>

<main id="indhold">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer__brand">{{ site.navn }}</div>
        <p>{{ site.footer_beskrivelse }}</p>
        <p>{{ site.adresse }}<br>{{ site.postnr_by }}</p>
      </div>
      <div>
        <h4>Sider</h4>
        <ul>
          <li><a href="/">Forside</a></li>
          <li><a href="/terapi/">Individuel terapi</a></li>
          <li><a href="/traumebehandling/">Traumebehandling</a></li>
          <li><a href="/familiebehandling/">Familiebehandling</a></li>
          <li><a href="/bisidderstoette/">Bisidderstøtte</a></li>
          <li><a href="/supervision/">Supervision</a></li>
          <li><a href="/priser/">Priser</a></li>
          <li><a href="/om-lotte/">Om Lotte</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
      </div>
      <div>
        <h4>Kontakt</h4>
        <ul>
          <li>Tlf. <a href="tel:{{ site.telefon_link }}">{{ site.telefon }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{{ site.facebook }}" rel="noopener">Facebook</a></li>
          <li><a href="{{ site.soestersite_url }}">{{ site.soestersite_navn }}</a></li>
          <li>CVR. {{ site.cvr }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 {{ site.navn }} &middot; Alle rettigheder forbeholdt</p>
      <ul>
        <li><a href="/privatlivspolitik/">Privatlivspolitik</a></li>
        {% if side != 'privatliv' %}
        <li>
          <a class="rediger-link" href="/admin/#/collections/sider/entries/{{ side }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
            Rediger denne side
          </a>
        </li>
        {% endif %}
      </ul>
    </div>
  </div>
</footer>

<script src="/assets/js/site.js"></script>
</body>
</html>
